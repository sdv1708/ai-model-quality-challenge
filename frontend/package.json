{
  "name": "performance-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "format:check": "prettier --check . --ignore-path ../.gitignore",
    "preview": "vite preview --host 127.0.0.1",
    "prepreview:e2e": "npm run build",
    "preview:e2e": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:built": "playwright test --config playwright.resilience.config.ts",
    "test:e2e:services": "playwright test --config playwright.services.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
